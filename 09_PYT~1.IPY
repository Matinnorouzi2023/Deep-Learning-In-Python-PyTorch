  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "view-in-github",
        "colab_type": "text"
      },
      "source": [
        "<a href=\"https://colab.research.google.com/github/ahoorarstmn/PyTorch_DL_FaraDars/blob/main/09_PyTorch_Image_Augmentation.ipynb\" target=\"_parent\"><img src=\"https://colab.research.google.com/assets/colab-badge.svg\" alt=\"Open In Colab\"/></a>"
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "# **Image Augmentation**\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n",
        "\n"
      ],
      "metadata": {
        "id": "rhInJ8Qr5opw"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import torch\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from PIL import Image\n",
        "from torchvision import transforms\n",
        "\n",
        "plt.rcParams[\"savefig.bbox\"] = 'tight'"
      ],
      "metadata": {
        "id": "zTE5OOWccJMb"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def visualize(imgs, **imshow_kwargs):\n",
        "    fig, axs = plt.subplots(1, len(imgs), figsize=(15, 15))\n",
        "    for row_idx, row in enumerate([imgs]):\n",
        "        for col_idx, img in enumerate(row):\n",
        "            ax = axs[col_idx] \n",
        "            ax.imshow(np.asarray(img))\n",
        "            ax.set(xticklabels=[], yticklabels=[], xticks=[], yticks=[])\n",
        "    plt.tight_layout()"
      ],
      "metadata": {
        "id": "cKMJjvVqRGbr"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "img_path = r\"/content/drive/MyDrive/Colab Notebooks/FaraDars PyTorch/images/tomato.jpg\"\n",
        "original_img = Image.open(img_path)\n",
        "original_img"
      ],
      "metadata": {
        "id": "Tp5TRoo-eE5x",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 242
        },
        "outputId": "aae4c2a7-f8ae-42d7-8cb7-6c76eefa9762"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "<PIL.JpegImagePlugin.JpegImageFile image mode=RGB size=225x225 at 0x7F64AD016F10>"
            ],
            "image/png": "\n"
          },
          "metadata": {},
          "execution_count": 3
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Non-Random Transforms"
      ],
      "metadata": {
        "id": "4LdRHVddVAYI"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Pad\n",
        "\n",
        "useful parameters:\n",
        "* `padding(int or sequence`)\n",
        "* `fill(number or tuple)`\n",
        "* `padding_mode(str)`"
      ],
      "metadata": {
        "id": "GQu9EXNB54DI"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "padded_imgs = [transforms.Pad(padding=padding, padding_mode='reflect')(original_img) for padding in (5, 15, 20, 45)]\n",
        "visualize(padded_imgs)"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 287
        },
        "id": "CPSGA7h6aHX4",
        "outputId": "f33a78b3-d0a1-4fac-8f75-ca6d6ccfbfaf"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1080x1080 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Resize\n",
        "\n",
        "useful parameters:\n",
        "* `size(sequence or int)`\n",
        "* `interpolation`"
      ],
      "metadata": {
        "id": "X1OPCEX-Ud7s"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "resized_imgs = [transforms.Resize(size=size)(original_img) for size in (30, 50, 100, original_img.size)]\n",
        "visualize(resized_imgs)"
      ],
      "metadata": {
        "id": "yciIcAdPwOC4",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 287
        },
        "outputId": "2d8a118a-4f6a-4e38-c376-fe97573483a0"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1080x1080 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### CenterCrop\n",
        "\n",
        "useful parameters:\n",
        "* `size(sequence or int)`"
      ],
      "metadata": {
        "id": "UfsQ9lQCUjgM"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "centercrop_imgs = [transforms.CenterCrop(size=size)(original_img) for size in (30, 50, 100, original_img.size)]\n",
        "visualize(centercrop_imgs)"
      ],
      "metadata": {
        "id": "QNvVl5x9wOzN",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 287
        },
        "outputId": "b3897751-1fe4-43c7-b80c-0d12c1e13d54"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1080x1080 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### FiveCrop"
      ],
      "metadata": {
        "id": "J7xG4frZUo02"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "(top_left, top_right, bottom_left, bottom_right, center) = transforms.FiveCrop(size=(100, 100))(original_img)\n",
        "visualize([top_left, top_right, bottom_left, bottom_right, center])"
      ],
      "metadata": {
        "id": "UzD0p4lKwQzR",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 234
        },
        "outputId": "22a55a8b-4210-4d75-d1e6-17e0acf43fa9"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1080x1080 with 5 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### Grayscale"
      ],
      "metadata": {
        "id": "4hrCJKRBUsAo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "gray_img = transforms.Grayscale()(original_img)\n",
        "gray_img"
      ],
      "metadata": {
        "id": "_Kw1RDx-wTdW",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 242
        },
        "outputId": "c6ceec7d-7fcb-4559-dc97-d925918cb72e"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "execute_result",
          "data": {
            "text/plain": [
              "<PIL.Image.Image image mode=L size=225x225 at 0x7F642FC9C050>"
            ],
            "image/png": "\n"
          },
          "metadata": {},
          "execution_count": 13
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Random Transforms"
      ],
      "metadata": {
        "id": "USbO2u1BVOFQ"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "### ColorJitter\n",
        "\n",
        "useful parameters:\n",
        "* `brightness`\n",
        "* `contrast`\n",
        "* `saturation`\n",
        "* `hue`"
      ],
      "metadata": {
        "id": "-pfaCokmVS5_"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "jitter_transform = transforms.ColorJitter(brightness=0.5, \n",
        "                                          contrast=0.5, \n",
        "                                          saturation=0.5, \n",
        "                                          hue=0.5)\n",
        "jitted_imgs = [jitter_transform(original_img) for _ in range(4)]\n",
        "visualize(jitted_imgs)"
      ],
      "metadata": {
        "id": "2W49XcfPwdqP",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 287
        },
        "outputId": "c5b52ad2-5de3-41b9-ad71-16e4075273fb"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1080x1080 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### RandomPerspective\n",
        "\n",
        "useful parameters:\n",
        "* `distortion_scale`\n",
        "* `p`\n",
        "* `interpolation`\n",
        "* `fill`"
      ],
      "metadata": {
        "id": "BaY0y2WKVbh4"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from torchvision.transforms.transforms import InterpolationMode\n",
        "rand_persp = transforms.RandomPerspective(distortion_scale=0.5,\n",
        "                                          p=1.0, \n",
        "                                          interpolation=InterpolationMode.NEAREST)\n",
        "perspective_imgs = [rand_persp(original_img) for _ in range(4)]\n",
        "visualize(perspective_imgs)"
      ],
      "metadata": {
        "id": "mK8NMo-awfzB",
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 287
        },
        "outputId": "2c811ae5-78c7-4326-a9f2-f94d51f4c751"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1080x1080 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "source": [
        "### RandomRotation\n",
        "\n",
        "useful parameters:\n",
        "* `degrees`\n",
        "* `interpolation`\n",
        "* `expand`\n",
        "* `center`\n",
        "* `fill`"
      ],
      "metadata": {
        "id": "83RONe5qVfyq"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "rotated_imgs = [transforms.RandomRotation(degrees=(0, 90), expand=True)(original_img) for _ in range(4)]\n",
        "visualize(rotated_imgs)"
      ],
      "metadata": {
        "id": "AcE4jlE7whMx",
        "colab": {
          "base_uri": "https://localhost:8080/",
